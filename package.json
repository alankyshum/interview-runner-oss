{
  "private": true,
  "type": "module",
  "workspaces": [
    "tools/ui-lint"
  ],
  "scripts": {
    "start": "node --import tsx server/start.ts",
    "start:sandboxd": "node --import tsx server/sandboxd-entry.ts",
    "build:client": "VITEST=1 vite build --configLoader runner && node scripts/check-excalidraw-worker.mjs && node scripts/compress-client.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test:production": "VITEST=1 INTERVIEW_RUNNER_CONTENT_SOURCE=db node --import tsx --test server/production-db.test.ts",
    "dev": "vite --host 0.0.0.0 --configLoader runner",
    "staging": "node scripts/staging.mjs",
    "dev:all": "concurrently \"npm run dev\" \"npm run test:json\"",
    "test": "vitest --configLoader runner",
    "test:ui": "vitest --configLoader runner --ui --api.port 51204",
    "test:json": "vitest --configLoader runner --watch --reporter=json --outputFile=.vitest-report.json",
    "test:run": "vitest run --configLoader runner",
    "test:runner": "vitest run src server scripts --configLoader runner --exclude 'server/production*.test.ts' --maxWorkers=1 && npm run test:production --if-present && npm run test:production:files --if-present",
    "lint": "npm run lint:seeds && npm run lint:ui",
    "lint:ui": "eslint --config tools/ui-lint/eslint.config.mjs src && node scripts/check-ui-css.mjs",
    "build": "npm run lint:seeds && npm run validate:courses && npm run validate:tests && npm run build:client && npm run build:server",
    "lint:seeds": "tsx scripts/lint-seeds.ts",
    "compose:repos": "tsx scripts/compose-repos.ts",
    "content:import": "tsx scripts/content-import.ts",
    "check:catalog-schema": "tsx scripts/check-catalog-schema.ts",
    "schema:gen": "tsx scripts/gen-course-schema.ts",
    "ir": "tsx scripts/ir-cli.ts",
    "content:compact-fts": "tsx scripts/content-compact-fts.ts",
    "content:migrate-workspaces": "tsx scripts/content-migrate-workspaces.ts",
    "content:export": "tsx scripts/content-export.ts",
    "content:workspaces": "tsx scripts/content-workspaces.ts",
    "auth:keys": "tsx scripts/auth-keys.ts",
    "sandbox:extensions": "sh scripts/install-sandbox-extensions.sh",
    "sandbox:parity": "tsx scripts/sandbox-parity.ts",
    "typecheck": "tsc --noEmit -p tsconfig.runner.json",
    "typecheck:all": "tsx scripts/typecheck-all.ts",
    "scaffold": "tsx scripts/scaffold-course.ts",
    "outline-ids": "tsx scripts/outline-ids.ts",
    "validate:courses": "tsx scripts/validate-course-paths-entry.ts",
    "validate:tests": "tsx scripts/validate-course-tests-entry.ts"
  },
  "dependencies": {
    "@datastructures-js/heap": "^4.3.7",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@mantine/spotlight": "^7.17.8",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-hotkeys": "0.16.0",
    "@typescript/typescript6": "^6.0.2",
    "connect": "^3.7.0",
    "dompurify": "^3.4.15",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "http-proxy-3": "2.0.2",
    "jose": "^6.2.12",
    "jsonc-parser": "3.3.1",
    "markmap-lib": "0.18.12",
    "markmap-view": "0.18.12",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "utility-types": "^3.11.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/connect": "^3.4.38",
    "@types/http-proxy": "1.17.17",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "latest",
    "@vitest/ui": "4.1.12",
    "ajv": "^8.20.0",
    "axe-core": "4.10.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.6",
    "fast-check": "latest",
    "jsdom": "latest",
    "ts-api-utils": "1.4.3",
    "tsx": "latest",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  }
}
