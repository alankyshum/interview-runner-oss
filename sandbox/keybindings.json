// Default editor keybindings for coding sandboxes. To use your own, put a
// keybindings.json in the directory named by "private" in config.json.
[
  {
    "key": "ctrl+alt+g g",
    "command": "workbench.scm.history.focus"
  },
  {
    "key": "f3",
    "command": "multiDiffEditor.goToNextChange",
    "when": "activeEditor == 'multiDiffEditor'"
  },
  {
    "key": "shift+f3",
    "command": "multiDiffEditor.goToPreviousChange",
    "when": "activeEditor == 'multiDiffEditor'"
  },
  {
    "key": "ctrl+alt+g f",
    "command": "multiDiffEditor.focusFileList",
    "when": "activeEditor == 'multiDiffEditor'"
  },
  {
    "key": "alt+down",
    "command": "list.focusDown",
    "when": "activeEditor == 'multiDiffEditor' && multiDiffEditorFileListFocus && listFocus"
  },
  {
    "key": "alt+up",
    "command": "list.focusUp",
    "when": "activeEditor == 'multiDiffEditor' && multiDiffEditorFileListFocus && listFocus"
  },
  {
    "key": "f3",
    "command": "workbench.action.compareEditor.nextChange",
    "when": "textCompareEditorVisible && activeEditor != 'multiDiffEditor'"
  },
  {
    "key": "shift+f3",
    "command": "workbench.action.compareEditor.previousChange",
    "when": "textCompareEditorVisible && activeEditor != 'multiDiffEditor'"
  },
  {
    "key": "cmd+right",
    "command": "cursorLineEnd",
    "when": "textInputFocus"
  },
  {
    "key": "cmd+shift+r",
    "command": "editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "cmd+k .",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "cmd+.",
    "command": "-editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+r",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && textInputFocus && !editorReadonly"
  },
  {
    "key": "shift+cmd+/",
    "command": "editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+a",
    "command": "-editor.action.blockComment",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+f",
    "command": "editor.action.formatSelection",
    "when": "editorHasSelection && editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+alt+f",
    "command": "editor.action.formatDocument",
    "when": "editorTextFocus && !editorHasSelection && !editorReadonly"
  },
  {
    "key": "ctrl+shift+cmd+left",
    "command": "editor.action.smartSelect.shrink",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+shift+cmd+right",
    "command": "editor.action.smartSelect.expand",
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+up",
    "command": "editor.action.moveLinesUpAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+down",
    "command": "editor.action.moveLinesDownAction",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+g",
    "command": "workbench.action.gotoLine"
  },
  {
    "key": "ctrl+r",
    "command": "workbench.action.gotoSymbol"
  },
  {
    "key": "ctrl+shift+g",
    "command": "interview-runner.viewSourceControl"
  },
  {
    "key": "ctrl+shift+e",
    "command": "interview-runner.viewExplorer"
  },
  {
    "key": "cmd+b",
    "command": "interview-runner.togglePrimarySidebar"
  },
  {
    "key": "cmd+alt+b",
    "command": "interview-runner.toggleSecondarySidebar"
  },
  {
    "key": "cmd+j",
    "command": "interview-runner.togglePanel"
  },
  {
    "key": "ctrl+j",
    "command": "interview-runner.togglePanel"
  },
  {
    "key": "cmd+1",
    "command": "-workbench.action.focusFirstGroup"
  },
  {
    "key": "cmd+2",
    "command": "-workbench.action.focusSecondGroup"
  },
  {
    "key": "cmd+3",
    "command": "-workbench.action.focusThirdGroup"
  },
  {
    "key": "cmd+4",
    "command": "-workbench.action.focusFourthGroup"
  },
  {
    "key": "cmd+5",
    "command": "-workbench.action.focusFifthGroup"
  },
  {
    "key": "cmd+6",
    "command": "-workbench.action.focusSixthGroup"
  },
  {
    "key": "cmd+7",
    "command": "-workbench.action.focusSeventhGroup"
  },
  {
    "key": "cmd+8",
    "command": "-workbench.action.focusEighthGroup"
  },
  {
    "key": "cmd+9",
    "command": "-workbench.action.focusNinthGroup"
  },
  {
    "key": "cmd+1",
    "command": "workbench.action.openEditorAtIndex1"
  },
  {
    "key": "cmd+2",
    "command": "workbench.action.openEditorAtIndex2"
  },
  {
    "key": "cmd+3",
    "command": "workbench.action.openEditorAtIndex3"
  },
  {
    "key": "cmd+4",
    "command": "workbench.action.openEditorAtIndex4"
  },
  {
    "key": "cmd+5",
    "command": "workbench.action.openEditorAtIndex5"
  },
  {
    "key": "cmd+6",
    "command": "workbench.action.openEditorAtIndex6"
  },
  {
    "key": "cmd+7",
    "command": "workbench.action.openEditorAtIndex7"
  },
  {
    "key": "cmd+8",
    "command": "workbench.action.openEditorAtIndex8"
  },
  {
    "key": "cmd+9",
    "command": "workbench.action.lastEditorInGroup"
  },
  {
    "key": "ctrl+1",
    "command": "workbench.action.openEditorAtIndex1"
  },
  {
    "key": "ctrl+2",
    "command": "workbench.action.openEditorAtIndex2"
  },
  {
    "key": "ctrl+3",
    "command": "workbench.action.openEditorAtIndex3"
  },
  {
    "key": "ctrl+4",
    "command": "workbench.action.openEditorAtIndex4"
  },
  {
    "key": "ctrl+5",
    "command": "workbench.action.openEditorAtIndex5"
  },
  {
    "key": "ctrl+6",
    "command": "workbench.action.openEditorAtIndex6"
  },
  {
    "key": "ctrl+7",
    "command": "workbench.action.openEditorAtIndex7"
  },
  {
    "key": "ctrl+8",
    "command": "workbench.action.openEditorAtIndex8"
  },
  {
    "key": "ctrl+9",
    "command": "workbench.action.lastEditorInGroup"
  },
  {
    "key": "f8",
    "command": "editor.action.marker.next",
    "when": "editorFocus"
  },
  {
    "key": "alt+f8",
    "command": "editor.action.marker.nextInFiles",
    "when": "editorFocus"
  },
  {
    "key": "shift+f8",
    "command": "editor.action.marker.prev",
    "when": "editorFocus"
  },
  {
    "key": "shift+cmd+f8",
    "command": "editor.action.marker.prevInFiles",
    "when": "editorFocus"
  }
]
