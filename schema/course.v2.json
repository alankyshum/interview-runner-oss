                          "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*?/)?\\.{1,2}(?:/|$))(?!.*//).+[^/]$|^[^/\\\\:.]$"
                        },
                        "scaffold": {
                          "type": "object",
