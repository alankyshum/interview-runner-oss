                        },
                        "title": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "kind": {
                          "enum": [
                            "logic",
                            "scratch"
                          ]
                        },
                        "estMinutes": {
                          "type": "number",
                          "minimum": 0
                        },
                        "sourcePath": {
                          "type": "string",
                          "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*?/)?\\.{1,2}(?:/|$))(?!.*//).+[^/]$|^[^/\\\\:.]$"
                        },
                        "instructions": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "contentType": {
                          "const": "coding"
                        },
                        "testPath": {
