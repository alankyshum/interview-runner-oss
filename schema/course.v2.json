                            "seedPath": {
                              "type": "string",
                              "pattern": "^(?!/)(?!.*[\\\\:])(?!(?:.*?/)?\\.{1,2}(?:/|$))(?!.*//).+[^/]$|^[^/\\\\:.]$"
                            }
                          },
                          "required": [
                            "seedPath"
                          ],
                          "additionalProperties": false
                        }
