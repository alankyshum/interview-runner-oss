      "properties": {
        "type": {
          "const": "map-recall"
        },
        "book": {
          "const": true
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "company": {
          "type": "string",
          "pattern": "\\S"
        },
        "tier": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "role": {
          "type": "string",
          "pattern": "\\S"
        },
        "interviewDate": {
          "type": "string",
          "pattern": "\\S"
        },
        "deadline": {
          "type": "string",
          "pattern": "\\S"
        },
        "createdAt": {
          "type": "string",
          "pattern": "\\S"
        },
        "updatedAt": {
          "type": "string",
          "pattern": "\\S"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
